# ═════════════════════════════════════════════════════════════════════════════
# 🌐 ENTORNO - Define en qué ambiente se ejecuta la aplicación
# ═════════════════════════════════════════════════════════════════════════════
#
# Valores posibles: development | staging | production
# Cada deploy (local, servidor staging, servidor producción) debe tener su
# propio archivo .env con el valor que corresponda.
APP_ENV=development

API_KEY=mock_api_key_change_me

# ═════════════════════════════════════════════════════════════════════════════
# 🔐 SEGURIDAD - API Keys y Autenticación JWT (NUEVO - 30/12/2025)
# ═════════════════════════════════════════════════════════════════════════════

# Secret Key para JWT Tokens (para futuro frontend con login)
# Generar: openssl rand -hex 32
# IMPORTANTE: Cambiar en producción
SECRET_KEY=mock_secret_key_change_me

# Algoritmo para JWT (HS256 es estándar)
JWT_ALGORITHM=HS256

# Expiración de JWT Token en minutos (access)
# 480 min = 8 horas (jornada laboral completa sin logout automático)
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Expiración de Refresh Token en minutos (30 días)
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# ═════════════════════════════════════════════════════════════════════════════
# SOBRE EL NUEVO SISTEMA DE API KEYS:
# ═════════════════════════════════════════════════════════════════════════════
# 
# El API_KEY anterior se mantiene para compatibilidad.
# Las nuevas API Keys se generan dinámicamente en la BD y se rotan automáticamente.
#
# Ver: docs/API_KEYS.md para documentación completa
#
# Horarios de automatización (zona Argentina):
#   2:00 AM → Rotar keys próximas a expirar (7 días antes)
#   3:30 AM → Limpiar keys expiradas
#   1:00 AM → Alertar sobre vencimientos (cada 3 días)
#   4:00 AM → Reporte de auditoría (domingos)

# --- BASE DE DATOS (POSTGRES) ---
# Estos valores deben coincidir con lo que pongas en docker-compose.yml
POSTGRES_USER=emerald_owner
POSTGRES_PASSWORD=mock_password_change_me
POSTGRES_DB=emerald_stock
POSTGRES_HOST=db
POSTGRES_PORT=5432

BEHOLDER_API_URL=/api
BEHOLDER_API_KEY=mock_api_key_change_me

PGADMIN_DEFAULT_EMAIL=developer@emerald.com.ar
PGADMIN_DEFAULT_PASSWORD=mock_password_change_me

SMARTOLT_API_URL=https://2finternet.vortex-m2.com/api
SMARTOLT_API_KEY=mock_api_key_change_me
# Credenciales comunes para todos los Mikrotik
MK_USER=beholder_api
MK_PASS=mock_password_change_me
MK_PORT=8799   # 👈 tu puerto personalizado
MK_HOST= 138.59.174.6 # mikrotik de laboratorio, comentar para producción
GENIEACS_URL=http://138.59.172.24:7557/devices

ISPCUBE_BASEURL=https://online21.ispcube.com/api
ISPCUBE_APIKEY=mock_api_key_change_me
ISPCUBE_USER=api
ISPCUBE_PASSWORD=mock_password_change_me
ISPCUBE_CLIENTID=423

# Variable de entorno para el frontend (Vite expone solo VITE_* al cliente)
# Docker inyecta: VITE_APP_ENV=${APP_ENV} en el contenedor frontend
VITE_APP_ENV=development

# URL de la API (Ahora es relativa porque usamos Nginx)
VITE_API_URL=/api
HOST_IP=138.59.172.26
RATE_LIMIT_MAX_ATTEMPTS_PER_USER=5
RATE_LIMIT_LOCKOUT_DURATION_MINUTES=10

# ═════════════════════════════════════════════════════════════════════════════
# 🧪 E2E Testing - Credenciales para automatización (Playwright)
# ═════════════════════════════════════════════════════════════════════════════

E2E_ADMIN_EMAIL="admin@emerald.com"
E2E_ADMIN_PASSWORD="mock_password_change_me"

E2E_OPERATOR_EMAIL="operator@emerald.com"
E2E_OPERATOR_PASSWORD="mock_password_change_me"

E2E_TECH_EMAIL="tecnico2@emerald.com"
E2E_TECH_PASSWORD="mock_password_change_me"
